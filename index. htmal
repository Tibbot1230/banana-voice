<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>🍌 Banana Voice Live</title>
  <style>
    :root {
      --bg: #0f172a;
      --card: #1e293b;
      --accent: #facc15;
      --accent-dark: #eab308;
      --text: #f8fafc;
      --muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, sans-serif;
    }

    body {
      background: radial-gradient(circle at top, #1e293b, #090d16);
      color: var(--text);
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .app {
      width: 100%;
      max-width: 540px;
      height: 100dvh;
      display: flex;
      flex-direction: column;
      padding: 14px;
      gap: 12px;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(30, 41, 59, 0.85);
      border: 1px solid rgba(250, 204, 21, 0.25);
      padding: 12px 14px;
      border-radius: 16px;
      backdrop-filter: blur(8px);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--accent);
    }

    .controls-top {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    select, button.icon-btn {
      background: #0f172a;
      color: var(--text);
      border: 1px solid rgba(148, 163, 184, 0.3);
      border-radius: 10px;
      padding: 6px 10px;
      font-size: 0.85rem;
      cursor: pointer;
    }

    .settings-panel {
      display: none;
      background: var(--card);
      border: 1px solid rgba(250, 204, 21, 0.3);
      border-radius: 14px;
      padding: 14px;
      gap: 10px;
      flex-direction: column;
      font-size: 0.85rem;
    }

    .settings-panel.open {
      display: flex;
    }

    .settings-panel input, .settings-panel select {
      width: 100%;
      padding: 9px 10px;
      border-radius: 10px;
      border: 1px solid #475569;
      background: #0f172a;
      color: var(--text);
      font-size: 0.9rem;
    }

    .settings-actions {
      display: flex;
      gap: 8px;
    }

    .btn-primary {
      background: var(--accent);
      color: #0f172a;
      border: none;
      padding: 8px 14px;
      border-radius: 10px;
      font-weight: 700;
      cursor: pointer;
      flex: 1;
    }

    .btn-secondary {
      background: #334155;
      color: var(--text);
      border: none;
      padding: 8px 14px;
      border-radius: 10px;
      cursor: pointer;
    }

    .chat-box {
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 6px 2px;
    }

    .msg {
      max-width: 85%;
      padding: 10px 14px;
      border-radius: 16px;
      line-height: 1.5;
      font-size: 0.95rem;
      word-wrap: break-word;
    }

    .msg.user {
      align-self: flex-end;
      background: var(--accent);
      color: #0f172a;
      font-weight: 500;
      border-bottom-right-radius: 4px;
    }

    .msg.bot {
      align-self: flex-start;
      background: var(--card);
      border: 1px solid rgba(148, 163, 184, 0.2);
      border-bottom-left-radius: 4px;
    }

    .voice-area {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 10px 0 4px;
    }

    .status-text {
      font-size: 0.85rem;
      color: var(--muted);
      min-height: 20px;
      text-align: center;
    }

    .mic-btn {
      width: 76px;
      height: 76px;
      border-radius: 50%;
      border: none;
      background: linear-gradient(135deg, var(--accent), var(--accent-dark));
      color: #0f172a;
      font-size: 1.9rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 0 22px rgba(250, 204, 21, 0.35);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .mic-btn:active {
      transform: scale(0.95);
    }

    .mic-btn.listening {
      background: linear-gradient(135deg, #ef4444, #dc2626);
      color: #fff;
      animation: pulse 1.3s infinite;
    }

    .mic-btn.speaking {
      background: linear-gradient(135deg, #22c55e, #16a34a);
      color: #fff;
      animation: pulse 1.3s infinite;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(250, 204, 21, 0.6); }
      70% { box-shadow: 0 0 0 20px rgba(250, 204, 21, 0); }
      100% { box-shadow: 0 0 0 0 rgba(250, 204, 21, 0); }
    }

    .text-bar {
      display: flex;
      gap: 8px;
      width: 100%;
    }

    .text-bar input {
      flex: 1;
      background: var(--card);
      border: 1px solid rgba(148, 163, 184, 0.3);
      color: var(--text);
      padding: 11px 14px;
      border-radius: 14px;
      font-size: 0.95rem;
      outline: none;
    }

    .text-bar button {
      background: var(--accent);
      color: #0f172a;
      border: none;
      padding: 0 18px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <div class="app">
    <header>
      <div class="brand">🍌 Banana Voice Live</div>
      <div class="controls-top">
        <select id="langSelect" aria-label="Language">
          <option value="bn-BD">বাংলা</option>
          <option value="en-US">English</option>
        </select>
        <button class="icon-btn" id="settingsToggle" title="Settings">⚙️</button>
      </div>
    </header>

    <div class="settings-panel" id="settingsPanel">
      <label for="apiKeyInput">Gemini API Key (ঐচ্ছিক - দিলে আরও বুদ্ধিমান উত্তর পাবেন):</label>
      <input type="password" id="apiKeyInput" placeholder="AIzaSy... (শুধু আপনার ফোনে সেভ থাকবে)" />
      <label for="modelSelect">মডেল নির্বাচন করুন:</label>
      <select id="modelSelect">
        <option value="gemini-3.8-flash">Gemini 3.8 Flash (সেরা)</option>
        <option value="gemini-3.5-flash-lite">Gemini 3.5 Flash-Lite (দ্রুত)</option>
      </select>
      <div class="settings-actions">
        <button class="btn-primary" id="saveSettings">সেভ করুন</button>
        <button class="btn-secondary" id="clearKey">Key মুছুন</button>
      </div>
      <span style="color: var(--muted); font-size: 0.78rem;">
        নোট: আপনার API Key কখনো GitHub-এ আপলোড হবে না, শুধু আপনার ব্রাউজারেই থাকবে।
      </span>
    </div>

    <div class="chat-box" id="chatBox">
      <div class="msg bot">
        হ্যালো! আমি 🍌 Banana Voice Live। নিচের মাইক্রোফোন বাটনে চাপ দিয়ে কথা বলুন অথবা লিখে প্রশ্ন করুন।
      </div>
    </div>

    <div class="voice-area">
      <div class="status-text" id="statusText">কথা বলতে মাইক বাটনে চাপ দিন</div>
      <button class="mic-btn" id="micBtn" aria-label="Start Voice">🎙️</button>

      <div class="text-bar">
        <input type="text" id="textInput" placeholder="অথবা এখানে লিখে পাঠান..." />
        <button id="sendBtn">➤</button>
      </div>
    </div>
  </div>

  <script>
    const chatBox = document.getElementById("chatBox");
    const micBtn = document.getElementById("micBtn");
    const statusText = document.getElementById("statusText");
    const textInput = document.getElementById("textInput");
    const sendBtn = document.getElementById("sendBtn");
    const langSelect = document.getElementById("langSelect");
    const settingsToggle = document.getElementById("settingsToggle");
    const settingsPanel = document.getElementById("settingsPanel");
    const apiKeyInput = document.getElementById("apiKeyInput");
    const modelSelect = document.getElementById("modelSelect");
    const saveSettingsBtn = document.getElementById("saveSettings");
    const clearKeyBtn = document.getElementById("clearKey");

    let isListening = false;
    let recognition = null;
    const history = [];

    apiKeyInput.value = localStorage.getItem("banana_api_key") || "";
    const savedModel = localStorage.getItem("banana_model");
    if (savedModel) modelSelect.value = savedModel;

    settingsToggle.addEventListener("click", () => {
      settingsPanel.classList.toggle("open");
    });

    saveSettingsBtn.addEventListener("click", () => {
      localStorage.setItem("banana_api_key", apiKeyInput.value.trim());
      localStorage.setItem("banana_model", modelSelect.value);
      settingsPanel.classList.remove("open");
      statusText.textContent = apiKeyInput.value.trim()
        ? "Gemini AI মোড চালু হয়েছে ✅"
        : "ডেমো ভয়েস মোড চালু রয়েছে ✅";
    });

    clearKeyBtn.addEventListener("click", () => {
      localStorage.removeItem("banana_api_key");
      apiKeyInput.value = "";
      statusText.textContent = "API Key মুছে ফেলা হয়েছে।";
    });

    function addMessage(text, sender) {
      const div = document.createElement("div");
      div.className = `msg ${sender}`;
      div.textContent = text;
      chatBox.appendChild(div);
      chatBox.scrollTop = chatBox.scrollHeight;
    }

    function cleanForSpeech(text) {
      return text.replace(/[*#_`~]/g, "").trim();
    }

    function speak(text) {
      if (!("speechSynthesis" in window)) return;
      window.speechSynthesis.cancel();

      const utter = new SpeechSynthesisUtterance(cleanForSpeech(text));
      const lang = langSelect.value;
      utter.lang = lang;

      const voices = window.speechSynthesis.getVoices();
      const shortLang = lang.split("-")[0];
      const match = voices.find((v) => v.lang.startsWith(shortLang));
      if (match) utter.voice = match;

      micBtn.classList.remove("listening");
      micBtn.classList.add("speaking");
      statusText.textContent = "বলছি... 🔊";

      utter.onend = () => {
        micBtn.classList.remove("speaking");
        statusText.textContent = "কথা বলতে মাইক বাটনে চাপ দিন";
      };

      utter.onerror = () => {
        micBtn.classList.remove("speaking");
        statusText.textContent = "কথা বলতে মাইক বাটনে চাপ দিন";
      };

      window.speechSynthesis.speak(utter);
    }

    function demoReply(promptText) {
      const q = promptText.toLowerCase();
      const isBn = langSelect.value.startsWith("bn");

      if (q.includes("সময়") || q.includes("কটা বাজে") || q.includes("time")) {
        const now = new Date().toLocaleTimeString("bn-BD", { hour: "2-digit", minute: "2-digit" });
        return isBn ? `এখন সময় ${now}।` : `The current time is ${new Date().toLocaleTimeString()}.`;
      }
      if (q.includes("তারিখ") || q.includes("date") || q.includes("আজ কি বার")) {
        const today = new Date().toLocaleDateString("bn-BD", { weekday: "long", year: "numeric", month: "long", day: "numeric" });
        return isBn ? `আজ ${today}।` : `Today is ${new Date().toDateString()}.`;
      }
      if (q.includes("হ্যালো") || q.includes("হাই") || q.includes("hello") || q.includes("hi") || q.includes("কেমন আছো")) {
        return isBn
          ? "হ্যালো! আমি ভালো আছি। আমি আপনার ব্যানানা ভয়েস অ্যাসিস্ট্যান্ট। কীভাবে সাহায্য করতে পারি?"
          : "Hello! I am Banana Voice Live. How can I help you today?";
      }
      if (q.includes("নাম কি") || q.includes("তুমি কে") || q.includes("who are you")) {
        return isBn
          ? "আমার নাম ব্যানানা ভয়েস লাইভ। আমি আপনার কথার উত্তর দিতে পারি।"
          : "I am Banana Voice Live, your browser voice assistant.";
      }

      return isBn
        ? `আপনি বলেছেন: "${promptText}"। আরও স্মার্ট AI উত্তর পেতে ওপরে ⚙️ সেটিংস থেকে একটি Gemini API Key যোগ করতে পারেন।`
        : `You said: "${promptText}". Add a Gemini API key in ⚙️ Settings for full AI answers.`;
    }

    async function getAIResponse(userText) {
      const apiKey = localStorage.getItem("banana_api_key");
      const model = localStorage.getItem("banana_model") || "gemini-3.8-flash";

      if (!apiKey) {
        return demoReply(userText);
      }

      history.push({ role: "user", parts: [{ text: userText }] });
      const recentHistory = history.slice(-8);

      try {
        statusText.textContent = "চিন্তা করছি... ⏳";
        const url = `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${encodeURIComponent(apiKey)}`;

        const res = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            systemInstruction: {
              parts: [{
                text: "You are Banana Voice Live, a friendly and concise voice assistant. Keep answers short (1-3 sentences) and natural for speaking aloud. Reply in the user's language (Bengali or English)."
              }]
            },
            contents: recentHistory
          })
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error?.message || "API Error");
        }

        const reply = data.candidates?.[0]?.content?.parts?.[0]?.text || "দুঃখিত, উত্তর পাওয়া যায়নি।";
        history.push({ role: "model", parts: [{ text: reply }] });
        return reply;
      } catch (err) {
        return `সমস্যা হয়েছে: ${err.message}`;
      }
    }

    async function handleUserInput(text) {
      const clean = text.trim();
      if (!clean) return;
      addMessage(clean, "user");
      const reply = await getAIResponse(clean);
      addMessage(reply, "bot");
      speak(reply);
    }

    sendBtn.addEventListener("click", () => {
      handleUserInput(textInput.value);
      textInput.value = "";
    });

    textInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        handleUserInput(textInput.value);
        textInput.value = "";
      }
    });

    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

    micBtn.addEventListener("click", () => {
      if ("speechSynthesis" in window) {
        window.speechSynthesis.cancel();
      }

      if (!SpeechRecognition) {
        statusText.textContent = "এই ব্রাউজারে সরাসরি মাইক সাপোর্ট করছে না, নিচে লিখে পাঠান।";
        return;
      }

      if (isListening && recognition) {
        recognition.stop();
        return;
      }

      recognition = new SpeechRecognition();
      recognition.lang = langSelect.value;
      recognition.interimResults = false;
      recognition.maxAlternatives = 1;

      recognition.onstart = () => {
        isListening = true;
        micBtn.classList.remove("speaking");
        micBtn.classList.add("listening");
        statusText.textContent = "শুনছি... এখন কথা বলুন 🎙️";
      };

      recognition.onresult = (event) => {
        const transcript = event.results[0][0].transcript;
        isListening = false;
        micBtn.classList.remove("listening");
        handleUserInput(transcript);
      };

      recognition.onerror = (event) => {
        isListening = false;
        micBtn.classList.remove("listening");
        statusText.textContent =
          event.error === "not-allowed"
            ? "মাইক্রোফোনের অনুমতি (Permission) দিন।"
            : "ভয়েস বুঝতে পারিনি, আবার চেষ্টা করুন।";
      };

      recognition.onend = () => {
        isListening = false;
        micBtn.classList.remove("listening");
      };

      recognition.start();
    });
  </script>
</body>
</html>
